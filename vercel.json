{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/plot",
      "destination": "/plot/index.html"
    },
    {
      "source": "/play",
      "destination": "/play/index.html"
    }
  ]
}